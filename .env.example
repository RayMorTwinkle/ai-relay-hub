# ===== ai-relay-hub 配置（复制为 .env 再改）=====

# ---- 对外端口 ----
AGG_PORT=8080        # 唯一 API 出口（new-api）
WB_PORT=8788         # wb 看板端口（供面板 OAuth 加账号，compose 默认只绑回环）

# ---- Qoder：仅支持 CN 后端 ----
# 到 https://qoder.com.cn/account/integrations 申请 Personal Access Token 填这里
# 不填也能起容器，但 qoder 渠道只会返回空模型表
QODERCN_PERSONAL_ACCESS_TOKEN=

# ---- WorkBuddy ----
# 不填则 wb 面板自动生成并在启动日志打印
WB_API_KEY=
# 可选：把国际版/国内版拆成两个独立渠道时，分别填在 wb 面板里绑定好出口的两个 Key
WB_API_KEY_INTL=
WB_API_KEY_CN=

# ---- OpenCode free-gate（免账号，走公共代理池）----
# auto / custom；PROXY_ORDER=CUSTOM_PROXIES= 等更多变量见上游 README
OC_PROXY_MODE=auto
# CUSTOM_PROXIES=
# ZENPROXY_KEY=

# ---- new-api 管理员 ----
# 首次启动用这个账号登录面板；上游默认 root/123456，改了密码后同步改这里
AGG_ADMIN_USER=root
AGG_ADMIN_PASS=Relay@4001
# 若上游提供 SYSTEM_ACCESS_TOKEN（服务器对接用），填这优先于账号登录
# SYSTEM_ACCESS_TOKEN=

# ---- wirer ----
WIRER_INTERVAL=30

# ---- 构建期（GitHub 直连受限环境才需要）----
# GH_PROXY_PREFIX=https://gh-proxy.com/
